# ==========================================
# LeadDesk Environment Configuration
# ==========================================

# General
NODE_ENV=development
APP_URL=http://localhost:4200

# Ports
BACKEND_PORT=4000
FRONTEND_PORT=4200
DB_PORT=5432

# PostgreSQL Database
DB_USER=leaddesk
DB_PASSWORD=leaddesk_secret
DB_NAME=leaddesk_dev
DATABASE_URL="postgresql://leaddesk:leaddesk_secret@localhost:5432/leaddesk_dev?schema=public"

# Authentication (JWT)
# Generate secure 256-bit secrets for production
JWT_ACCESS_SECRET="dev_access_secret_change_in_production_min_32_chars"
JWT_REFRESH_SECRET="dev_refresh_secret_change_in_production_min_32_chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# Default Single-Owner Bootstrap Credentials
INITIAL_OWNER_EMAIL="lead@example.com"
INITIAL_OWNER_PASSWORD="ChangeMeImmediately123!"
INITIAL_OWNER_NAME="Team Lead"
INITIAL_OWNER_TIMEZONE="Asia/Karachi"

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH="./uploads"

# CORS
CORS_ORIGIN="http://localhost:4200"
